{% import 'tmsm_widgets/frame.xml' as widgets with context %}

{% set widget_w = widget_w|default(46.0) %}
{% set widget_h = widget_h|default(11.0) %}

{% call widgets.frame() %}
  <label pos="1.2 -1.3" z-index="42" text="$dddKARMA" textsize="0.95" textfont="GameFontBlack" />
  <label pos="{{ widget_w - 1.2 }} -1.3" z-index="42" halign="right"
         text="$aaa{{ source|default('N/A') }}" textsize="0.8" textfont="GameFontBlack" />

  <quad pos="1.2 -4.3" z-index="41" size="{{ widget_w - 2.4 }} 0.8" bgcolor="2228" />
  <quad pos="1.2 -4.3" z-index="42" size="{{ ((widget_w - 2.4) * (bar_pct|default(0)|float) / 100.0)|round(2) }} 0.8"
        bgcolor="44cc88ee" />

  <label pos="1.5 -7.7" z-index="42" text="$fff{{ percent_text|default('+0.0%') }}"
         textsize="1.2" textfont="GameFontBlack" />
  <label pos="{{ widget_w / 2 }} -7.7" z-index="42" halign="center"
         text="${{ score_color|default('aaa') }}{{ score_text|default('+0.0') }}"
         textsize="1.2" textfont="GameFontBlack" />
  <label pos="{{ widget_w - 1.5 }} -7.7" z-index="42" halign="right"
         text="$cccV:{{ count|default(0) }}  You:{{ my_vote|default('--') }}"
         textsize="0.9" textfont="GameFontBlack" />
{% endcall %}
