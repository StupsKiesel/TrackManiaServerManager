{# tmsm_widgets/panels.xml — reusable panel & label macros.

   Themed widgets can pick a skin instead of laying out raw quads. Every
   macro consumes the `theme_*` and `theme_*_c` flat vars injected by
   `ThemedWidgetApp.frame_context`, with safe fallbacks so non-themed
   widgets still render (just in default dark colors).

   Usage in a widget template:

       {% import 'tmsm_widgets/panels.xml' as p with context %}
       {% call p.strip_top(title='Records', w=widget_w, h=widget_h) %}
         <label text="row 1" />
       {% endcall %}

   Every panel macro accepts:
     title   — header text (omit / empty for no header)
     x, y    — local position inside the widget frame (default 0, 0)
     w, h    — outer size in ML units
     accent  — override accent color (defaults to active theme accent)

   All panels render the title bar (when title is set), reserve 5 ML units
   of vertical space for it, and call caller() with no offset — your body
   content is responsible for placing itself below the header band if
   one is shown. Use the `BODY_TOP` convenience variable that each macro
   exports through caller() context (Jinja "set in caller scope" is awkward,
   so we just document it: BODY_TOP = -5 when title is shown, else 0).

   Label helpers also live here (see bottom of file).
#}

{# ────────────────────────────────────────────────────────────────────────
   Theme fallbacks — keep panels usable from non-themed widgets too.
   ──────────────────────────────────────────────────────────────────────── #}
{% set _t_panel        = theme_panel        |default('111c',     true) %}
{% set _t_panel_alt    = theme_panel_alt    |default('1a1a1add', true) %}
{% set _t_bg_elev      = theme_bg_elev      |default('222222ee', true) %}
{% set _t_header_bg    = theme_header_bg    |default('0a0a0aee', true) %}
{% set _t_header_acc   = theme_header_accent|default('15dfa',    true) %}
{% set _t_header_txt_c = theme_header_text_c|default('fff',      true) %}
{% set _t_border       = theme_border       |default('ffffff22', true) %}
{% set _t_border_str   = theme_border_strong|default('ffffff55', true) %}
{% set _t_accent       = theme_accent       |default('15dfa',    true) %}
{% set _t_accent_soft  = theme_accent_soft  |default('15dfa33',  true) %}
{% set _t_shadow       = theme_shadow       |default('000000aa', true) %}
{% set _t_glow         = theme_glow         |default('15dfa55',  true) %}
{% set _t_text_c       = theme_text_c       |default('fff',      true) %}
{% set _t_text_str_c   = theme_text_strong_c|default('fff',      true) %}
{% set _t_text_mut_c   = theme_text_muted_c |default('aaa',      true) %}
{% set _t_text_on_a_c  = theme_text_on_accent_c|default('111',   true) %}
{% set _t_font         = theme_font_text   |default('GameFont',     true) %}
{% set _t_font_strong  = theme_font_strong |default('GameFontBlack', true) %}


{# ────────────────────────────────────────────────────────────────────────
   1) minimal — flat panel + thin border. Title in muted strong font.
   ──────────────────────────────────────────────────────────────────────── #}
{% macro minimal(title='', x=0, y=0, w=40, h=10, accent='') %}
  {% set acc = accent or _t_accent %}
  <quad pos="{{ x }} {{ y }}" z-index="40" size="{{ w }} {{ h }}"
        bgcolor="{{ _t_panel }}" halign="left" valign="top" />
  <quad pos="{{ x }} {{ y }}" z-index="41" size="{{ w }} 0.15"
        bgcolor="{{ _t_border }}" halign="left" valign="top" />
  <quad pos="{{ x }} {{ y - h }}" z-index="41" size="{{ w }} 0.15"
        bgcolor="{{ _t_border }}" halign="left" valign="top" />
  {% if title %}
    <label pos="{{ x + 1.5 }} {{ y - 2.6 }}" z-index="43"
           halign="left" valign="center2"
           text="${{ _t_text_str_c }}{{ title }}"
           textsize="1.0" textfont="{{ _t_font_strong }}" />
  {% endif %}
  {{ caller() }}
{% endmacro %}


{# ────────────────────────────────────────────────────────────────────────
   2) strip_top — colored accent strip across the top, title sits below it.
   ──────────────────────────────────────────────────────────────────────── #}
{% macro strip_top(title='', x=0, y=0, w=40, h=10, accent='') %}
  {% set acc = accent or _t_accent %}
  <quad pos="{{ x }} {{ y }}" z-index="40" size="{{ w }} {{ h }}"
        bgcolor="{{ _t_panel }}" halign="left" valign="top" />
  <quad pos="{{ x }} {{ y }}" z-index="41" size="{{ w }} 1.0"
        bgcolor="{{ acc }}" halign="left" valign="top" />
  {% if title %}
    <label pos="{{ x + 1.5 }} {{ y - 3.4 }}" z-index="43"
           halign="left" valign="center2"
           text="${{ _t_text_str_c }}{{ title }}"
           textsize="1.1" textfont="{{ _t_font_strong }}" />
  {% endif %}
  {{ caller() }}
{% endmacro %}


{# ────────────────────────────────────────────────────────────────────────
   3) strip_left — vertical accent strip on the left.
   ──────────────────────────────────────────────────────────────────────── #}
{% macro strip_left(title='', x=0, y=0, w=40, h=10, accent='') %}
  {% set acc = accent or _t_accent %}
  <quad pos="{{ x }} {{ y }}" z-index="40" size="{{ w }} {{ h }}"
        bgcolor="{{ _t_panel }}" halign="left" valign="top" />
  <quad pos="{{ x }} {{ y }}" z-index="41" size="1.0 {{ h }}"
        bgcolor="{{ acc }}" halign="left" valign="top" />
  {% if title %}
    <label pos="{{ x + 2.5 }} {{ y - 2.8 }}" z-index="43"
           halign="left" valign="center2"
           text="${{ _t_text_str_c }}{{ title }}"
           textsize="1.05" textfont="{{ _t_font_strong }}" />
    <quad pos="{{ x + 2.5 }} {{ y - 4.6 }}" z-index="42"
          size="{{ w - 4 }} 0.15"
          bgcolor="{{ _t_border }}" halign="left" valign="top" />
  {% endif %}
  {{ caller() }}
{% endmacro %}


{# ────────────────────────────────────────────────────────────────────────
   4) strip_bottom — accent strip across bottom edge.
   ──────────────────────────────────────────────────────────────────────── #}
{% macro strip_bottom(title='', x=0, y=0, w=40, h=10, accent='') %}
  {% set acc = accent or _t_accent %}
  <quad pos="{{ x }} {{ y }}" z-index="40" size="{{ w }} {{ h }}"
        bgcolor="{{ _t_panel }}" halign="left" valign="top" />
  <quad pos="{{ x }} {{ y - h + 1.0 }}" z-index="41"
        size="{{ w }} 1.0" bgcolor="{{ acc }}" halign="left" valign="top" />
  {% if title %}
    <label pos="{{ x + 1.5 }} {{ y - 2.6 }}" z-index="43"
           halign="left" valign="center2"
           text="${{ _t_text_str_c }}{{ title }}"
           textsize="1.0" textfont="{{ _t_font_strong }}" />
  {% endif %}
  {{ caller() }}
{% endmacro %}


{# ────────────────────────────────────────────────────────────────────────
   5) card — elevated panel with drop-shadow quad behind it.
   ──────────────────────────────────────────────────────────────────────── #}
{% macro card(title='', x=0, y=0, w=40, h=10, accent='') %}
  {% set acc = accent or _t_accent %}
  {# shadow quad slightly offset #}
  <quad pos="{{ x + 0.6 }} {{ y - 0.6 }}" z-index="39" size="{{ w }} {{ h }}"
        bgcolor="{{ _t_shadow }}" halign="left" valign="top" />
  <quad pos="{{ x }} {{ y }}" z-index="40" size="{{ w }} {{ h }}"
        bgcolor="{{ _t_bg_elev }}" halign="left" valign="top" />
  {# header band #}
  {% if title %}
    <quad pos="{{ x }} {{ y }}" z-index="41" size="{{ w }} 5.0"
          bgcolor="{{ _t_header_bg }}" halign="left" valign="top" />
    <quad pos="{{ x }} {{ y - 4.85 }}" z-index="42" size="{{ w }} 0.15"
          bgcolor="{{ acc }}" halign="left" valign="top" />
    <label pos="{{ x + 1.6 }} {{ y - 2.6 }}" z-index="43"
           halign="left" valign="center2"
           text="${{ _t_header_txt_c }}{{ title }}"
           textsize="1.1" textfont="{{ _t_font_strong }}" />
  {% endif %}
  {{ caller() }}
{% endmacro %}


{# ────────────────────────────────────────────────────────────────────────
   6) chip — title sits inside a small filled chip on the top-left.
   ──────────────────────────────────────────────────────────────────────── #}
{% macro chip(title='', x=0, y=0, w=40, h=10, accent='') %}
  {% set acc = accent or _t_accent %}
  <quad pos="{{ x }} {{ y }}" z-index="40" size="{{ w }} {{ h }}"
        bgcolor="{{ _t_panel }}" halign="left" valign="top" />
  {% if title %}
    {% set chip_w = (title|length) * 1.2 + 4 %}
    <quad pos="{{ x + 1.4 }} {{ y - 1.4 }}" z-index="41"
          size="{{ chip_w }} 3.4" bgcolor="{{ acc }}" halign="left" valign="top" />
    <label pos="{{ x + 1.4 + chip_w / 2 }} {{ y - 3.1 }}" z-index="42"
           halign="center" valign="center2"
           text="${{ _t_text_on_a_c }}{{ title }}"
           textsize="0.95" textfont="{{ _t_font_strong }}" />
  {% endif %}
  {{ caller() }}
{% endmacro %}


{# ────────────────────────────────────────────────────────────────────────
   7) outline — bold accent border, transparent inner fill, strong-font title.
   ──────────────────────────────────────────────────────────────────────── #}
{% macro outline(title='', x=0, y=0, w=40, h=10, accent='') %}
  {% set acc = accent or _t_accent %}
  {# inner soft fill so contents read against any background #}
  <quad pos="{{ x }} {{ y }}" z-index="40" size="{{ w }} {{ h }}"
        bgcolor="{{ _t_panel_alt }}" halign="left" valign="top" />
  {# 4 border quads #}
  <quad pos="{{ x }} {{ y }}" z-index="42" size="{{ w }} 0.4"
        bgcolor="{{ acc }}" halign="left" valign="top" />
  <quad pos="{{ x }} {{ y - h }}" z-index="42" size="{{ w }} 0.4"
        bgcolor="{{ acc }}" halign="left" valign="top" />
  <quad pos="{{ x }} {{ y }}" z-index="42" size="0.4 {{ h }}"
        bgcolor="{{ acc }}" halign="left" valign="top" />
  <quad pos="{{ x + w - 0.4 }} {{ y }}" z-index="42" size="0.4 {{ h }}"
        bgcolor="{{ acc }}" halign="left" valign="top" />
  {% if title %}
    {# title block sits over the top border #}
    {% set tw = (title|length) * 1.15 + 3 %}
    <quad pos="{{ x + 1.5 }} {{ y + 0.6 }}" z-index="43"
          size="{{ tw }} 2.8" bgcolor="{{ _t_panel }}" halign="left" valign="top" />
    <label pos="{{ x + 1.5 + tw / 2 }} {{ y - 0.8 }}" z-index="44"
           halign="center" valign="center2"
           text="${{ _t_text_str_c }}{{ title }}"
           textsize="0.95" textfont="{{ _t_font_strong }}" />
  {% endif %}
  {{ caller() }}
{% endmacro %}


{# ────────────────────────────────────────────────────────────────────────
   8) inset — dark header band recessed below body. Looks like a HUD strip.
   ──────────────────────────────────────────────────────────────────────── #}
{% macro inset(title='', x=0, y=0, w=40, h=10, accent='') %}
  {% set acc = accent or _t_accent %}
  <quad pos="{{ x }} {{ y }}" z-index="40" size="{{ w }} {{ h }}"
        bgcolor="{{ _t_panel }}" halign="left" valign="top" />
  {% if title %}
    <quad pos="{{ x + 0.6 }} {{ y - 0.6 }}" z-index="41"
          size="{{ w - 1.2 }} 4.0" bgcolor="{{ _t_header_bg }}"
          halign="left" valign="top" />
    {# left accent bar inside the header #}
    <quad pos="{{ x + 0.6 }} {{ y - 0.6 }}" z-index="42"
          size="0.6 4.0" bgcolor="{{ acc }}" halign="left" valign="top" />
    <label pos="{{ x + 2.0 }} {{ y - 2.6 }}" z-index="43"
           halign="left" valign="center2"
           text="${{ _t_header_txt_c }}{{ title }}"
           textsize="1.05" textfont="{{ _t_font_strong }}" />
  {% endif %}
  {{ caller() }}
{% endmacro %}


{# ────────────────────────────────────────────────────────────────────────
   9) neon — soft glow quad behind, accent borders. For "look-at-me" widgets.
   ──────────────────────────────────────────────────────────────────────── #}
{% macro neon(title='', x=0, y=0, w=40, h=10, accent='') %}
  {% set acc = accent or _t_accent %}
  {# glow halo #}
  <quad pos="{{ x - 1.0 }} {{ y + 1.0 }}" z-index="38"
        size="{{ w + 2.0 }} {{ h + 2.0 }}" bgcolor="{{ _t_glow }}"
        halign="left" valign="top" />
  <quad pos="{{ x }} {{ y }}" z-index="40" size="{{ w }} {{ h }}"
        bgcolor="{{ _t_panel }}" halign="left" valign="top" />
  {# accent borders top + bottom #}
  <quad pos="{{ x }} {{ y }}" z-index="42" size="{{ w }} 0.5"
        bgcolor="{{ acc }}" halign="left" valign="top" />
  <quad pos="{{ x }} {{ y - h + 0.5 }}" z-index="42" size="{{ w }} 0.5"
        bgcolor="{{ acc }}" halign="left" valign="top" />
  {% if title %}
    <label pos="{{ x + w / 2 }} {{ y - 3.0 }}" z-index="43"
           halign="center" valign="center2"
           text="${{ _t_text_str_c }}{{ title }}"
           textsize="1.2" textfont="{{ _t_font_strong }}" />
  {% endif %}
  {{ caller() }}
{% endmacro %}


{# ────────────────────────────────────────────────────────────────────────
  10) badge — small filled accent square left of a strong title, on a flat panel.
   ──────────────────────────────────────────────────────────────────────── #}
{% macro badge(title='', x=0, y=0, w=40, h=10, accent='', icon='') %}
  {% set acc = accent or _t_accent %}
  <quad pos="{{ x }} {{ y }}" z-index="40" size="{{ w }} {{ h }}"
        bgcolor="{{ _t_panel }}" halign="left" valign="top" />
  {# accent square #}
  <quad pos="{{ x + 1.2 }} {{ y - 1.2 }}" z-index="41"
        size="3.0 3.0" bgcolor="{{ acc }}" halign="left" valign="top" />
  {% if icon %}
    <label pos="{{ x + 2.7 }} {{ y - 2.7 }}" z-index="42"
           halign="center" valign="center2"
           text="${{ _t_text_on_a_c }}{{ icon }}"
           textsize="1.0" textfont="{{ _t_font_strong }}" />
  {% endif %}
  {% if title %}
    {# shadow label first, real label over it #}
    <label pos="{{ x + 5.4 + 0.15 }} {{ y - 2.6 - 0.15 }}" z-index="42"
           halign="left" valign="center2"
           text="${{ _t_text_mut_c }}{{ title }}"
           textsize="1.1" textfont="{{ _t_font_strong }}" />
    <label pos="{{ x + 5.4 }} {{ y - 2.6 }}" z-index="43"
           halign="left" valign="center2"
           text="${{ _t_text_str_c }}{{ title }}"
           textsize="1.1" textfont="{{ _t_font_strong }}" />
    <quad pos="{{ x + 5.4 }} {{ y - 4.4 }}" z-index="42"
          size="{{ (title|length) * 1.05 + 1.5 }} 0.2"
          bgcolor="{{ acc }}" halign="left" valign="top" />
  {% endif %}
  {{ caller() }}
{% endmacro %}


{# ════════════════════════════════════════════════════════════════════════
   Label helpers — used inside any panel's caller() body.
   ════════════════════════════════════════════════════════════════════════ #}

{# Shadow text — two stacked labels (back muted + offset, front strong). #}
{% macro shadow_label(text, x=0, y=0, size=1.0, halign='left',
                       color_c='', shadow_c='', font='') %}
  {% set fc = color_c or _t_text_str_c %}
  {% set sc = shadow_c or '000' %}
  {% set fn = font or _t_font_strong %}
  <label pos="{{ x + 0.18 }} {{ y - 0.18 }}" z-index="44"
         halign="{{ halign }}" valign="center2"
         text="${{ sc }}{{ text }}"
         textsize="{{ size }}" textfont="{{ fn }}" />
  <label pos="{{ x }} {{ y }}" z-index="45"
         halign="{{ halign }}" valign="center2"
         text="${{ fc }}{{ text }}"
         textsize="{{ size }}" textfont="{{ fn }}" />
{% endmacro %}

{# Label sitting on a filled accent square. #}
{% macro chip_label(text, x=0, y=0, w=14, h=4, accent='',
                     color_c='', font='') %}
  {% set acc = accent or _t_accent %}
  {% set fc  = color_c or _t_text_on_a_c %}
  {% set fn  = font or _t_font_strong %}
  <quad pos="{{ x }} {{ y }}" z-index="44" size="{{ w }} {{ h }}"
        bgcolor="{{ acc }}" halign="left" valign="top" />
  <label pos="{{ x + w / 2 }} {{ y - h / 2 }}" z-index="45"
         halign="center" valign="center2"
         text="${{ fc }}{{ text }}"
         textsize="0.95" textfont="{{ fn }}" />
{% endmacro %}

{# Underlined label (accent line under the baseline). #}
{% macro underline_label(text, x=0, y=0, size=1.0, halign='left',
                          accent='', color_c='', font='') %}
  {% set acc = accent or _t_accent %}
  {% set fc  = color_c or _t_text_str_c %}
  {% set fn  = font or _t_font_strong %}
  <label pos="{{ x }} {{ y }}" z-index="45"
         halign="{{ halign }}" valign="center2"
         text="${{ fc }}{{ text }}"
         textsize="{{ size }}" textfont="{{ fn }}" />
  {% set tw = (text|length) * size * 1.05 %}
  {% set ux = x - (tw if halign == 'right' else (tw / 2 if halign == 'center' else 0)) %}
  <quad pos="{{ ux }} {{ y - size * 1.1 }}" z-index="44"
        size="{{ tw }} 0.2" bgcolor="{{ acc }}" halign="left" valign="top" />
{% endmacro %}
