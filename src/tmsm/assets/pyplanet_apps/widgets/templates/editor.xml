{% import 'tmsm_ui/widgets.xml' as ui with context %}

{# tmsm_widgets editor — admin position editor. Context: rows, selected_key,
   selected_name, scope ('global'|'player'), step, step_options. #}

{% set WIN_W = 170 %}
{% set WIN_H = 128 %}
{% set ROW_H = 11 %}
{% set LIST_W = 70 %}
{% set EDIT_X = LIST_W + 4 %}
{% set EDIT_W = WIN_W - EDIT_X - 4 %}

<frame pos="-85 55" z-index="500">

  {{ ui.window('Widgets · position editor', icon='object-group', x=0, y=0, w=WIN_W, h=WIN_H) }}

  {# vertical divider between columns #}
  <quad pos="{{ LIST_W + 2 }} -10" size="0.2 {{ WIN_H - 12 }}"
        valign="top" bgcolor="ffffff22" z-index="509" />

  {# ── left column: widget list ──────────────────────────────────────── #}
  <frame pos="2 -10" z-index="510">
    {% for row in rows %}
      {% set y = -(loop.index0 * (ROW_H + 1)) %}
      {# row background #}
      <quad pos="0 {{ y }}" size="{{ LIST_W }} {{ ROW_H }}" valign="top"
            bgcolor="{{ '1a4fa6cc' if row.selected else '0a0a0a88' }}" />
      {# left accent strip on selected row #}
      {% if row.selected %}
        <quad pos="0 {{ y }}" size="0.8 {{ ROW_H }}" valign="top" bgcolor="15dfa" />
      {% endif %}
      {# icon tile #}
      <quad pos="1.5 {{ y - 1.5 }}" size="8 8" valign="top"
            bgcolor="{{ '15dfa44' if row.selected else 'ffffff10' }}" />
      {{ ui.icon(row.icon, x=5.5, y=y - 5.5, color='15f' if row.selected else 'ccc',
                 font=3.4, z=512) }}
      {# name (bold) #}
      <label pos="11 {{ y - 1.2 }}" textsize="1.0" textfont="GameFontBlack" valign="top"
             text="$fff{{ row.name }}" />
      {# key (mono, dim) #}
      <label pos="11 {{ y - 4.1 }}" textsize="0.7" valign="top"
             text="$777{{ row.key }}" />
      {# bottom line: scope-aware position + size #}
      <label pos="11 {{ y - 7.6 }}" textsize="0.7" valign="top"
             text="$aaaSize $fff{{ '%.0f' | format(row.w) }}×{{ '%.0f' | format(row.h) }}  $666·  $aaaPos $fff{{ '%.1f' | format(row.x) }} , {{ '%.1f' | format(row.y) }}" />
      {# kind badge (top-right) #}
      <quad pos="{{ LIST_W - 1.5 }} {{ y - 1.2 }}" size="10 3.2" valign="top" halign="right"
            bgcolor="{{ '15dfa66' if row.selected else 'ffffff14' }}" />
      <label pos="{{ LIST_W - 2.5 }} {{ y - 1.4 }}" textsize="0.65" halign="right" valign="top"
             textfont="GameFontBlack"
             text="${{ 'fff' if row.selected else 'bbb' }}{{ row.kind|upper }}" />
      {# click target — kept LAST so it sits on top #}
      <quad pos="0 {{ y }}" size="{{ LIST_W }} {{ ROW_H }}" valign="top" bgcolor="0000"
            id="uibtn_ghost_{{ id }}__select__{{ row.key }}"
            action="{{ id }}__select__{{ row.key }}" scriptevents="1"
            class="ui-btn ui-btn-ghost"
            tooltip="{{ row.name }} ({{ row.kind }})" />
    {% else %}
      <quad pos="0 -10" size="{{ LIST_W }} 12" valign="top" bgcolor="0a0a0a88" />
      <label pos="{{ LIST_W / 2 }} -16" halign="center" textsize="0.9"
             text="$aaaNo widgets registered." />
    {% endfor %}
  </frame>

  {# ── right column: edit panel ──────────────────────────────────────── #}
  {% if selected_key %}
  <frame pos="{{ EDIT_X }} -10" z-index="510">

    {# header — widget name + key #}
    <label pos="0 0" textsize="1.2" textfont="GameFontBlack"
           text="$fff{{ selected_name }}" />
    <label pos="0 -3.5" textsize="0.75" text="$888{{ selected_key }}" />
    <quad pos="0 -7" size="{{ EDIT_W }} 0.2" bgcolor="ffffff22" />

    {# ── options group (scope · personalization · slide · timings) ── #}
    {% call ui.group_box('Options', x=0, y=-10, w=EDIT_W, h=46, color='aaa') %}
      {# row 1: scope radios #}
      {{ ui.radio_group('scope',
                         [('global', 'Global'), ('player', 'Personal')],
                         selected=scope, x=4, y=-17, orient='h', gap=22, size='sm') }}
      {% if not allow_personal %}
        {# dim overlay over the Personal radio + label to signal disabled #}
        <quad pos="18 -17" size="32 5" valign="center2" bgcolor="000000aa" />
      {% endif %}

      {# row 2: master-only toggles, sit just under the scope radios #}
      {% if is_master %}
        {{ ui.check_box('allowperson__' ~ selected_key,
                        label='Allow personalization',
                        checked=allow_personal,
                        x=4, y=-25, size='sm') }}
        {{ ui.check_box('drive__' ~ selected_key,
                        label='Hide while driving',
                        checked=behavior.get('hide_while_driving', True),
                        x=46, y=-25, size='sm') }}
      {% endif %}

      {# row 3: slide direction tiles #}
      <label pos="4 -35" textsize="0.85" valign="center2" text="$aaaSlide" />
      {% set TILE_X = 16 %}
      {% set TILE_Y = -35 %}
      {% set TILE_W = 8 %}
      {% set TILE_H = 5 %}
      {% set TILE_GAP = 9 %}
      {% for dval, dicon, dtext in [
            ('none',  None,          '\u2014'),
            ('left',  'arrow_left',  None),
            ('right', 'arrow_right', None),
            ('up',    'arrow_up',    None),
            ('down',  'arrow_down',  None)] %}
        {% set bx = TILE_X + loop.index0 * TILE_GAP %}
        {% set is_sel = behavior.get('anim_dir', 'right') == dval %}
        <quad pos="{{ bx }} {{ TILE_Y }}" size="{{ TILE_W }} {{ TILE_H }}"
              bgcolor="{{ '15dfa66' if is_sel else 'ffffff14' }}" valign="center2"
              id="uibtn_dir_{{ selected_key }}_{{ dval }}"
              action="{{ id }}__setdir__{{ selected_key }}|{{ dval }}" scriptevents="1"
              class="ui-btn ui-btn-ghost" />
        {% if dicon %}
          {{ ui.icon(dicon, x=bx + TILE_W/2, y=TILE_Y,
                     color='fff' if is_sel else 'aaa', font=2.2, z=201) }}
        {% else %}
          <label pos="{{ bx + TILE_W/2 }} {{ TILE_Y }}" halign="center" valign="center2"
                 textsize="1.0" textfont="GameFontBlack"
                 text="${{ 'fff' if is_sel else 'aaa' }}{{ dtext }}" />
        {% endif %}
      {% endfor %}

      {# row 4: duration + delay entries #}
      {% set R4_Y = -45 %}
      <label pos="4 {{ R4_Y }}" textsize="0.85" valign="center2" text="$aaaDur ms" />
      <quad  pos="22 {{ R4_Y }}" size="14 4" bgcolor="0008" valign="center2" />
      <entry pos="22 {{ R4_Y }}" size="14 4"
             name="entry_widget_{{ selected_key }}_anim_duration_ms"
             default="{{ behavior.get('anim_duration_ms', 300) }}"
             textsize="1" valign="center2" />
      <label pos="42 {{ R4_Y }}" textsize="0.85" valign="center2" text="$aaaDelay ms" />
      <quad  pos="60 {{ R4_Y }}" size="14 4" bgcolor="0008" valign="center2" />
      <entry pos="60 {{ R4_Y }}" size="14 4"
             name="entry_widget_{{ selected_key }}_anim_delay_ms"
             default="{{ behavior.get('anim_delay_ms', 0) }}"
             textsize="1" valign="center2" />
    {% endcall %}

    {# ── nudge group (d-pad + step selector) ────────────────────── #}
    {% call ui.group_box('Nudge', x=0, y=-58, w=38, h=32, color='aaa') %}
      {# d-pad: buttons centered around (CX, CY) #}
      {% set CX = 19 %}
      {% set CY = -68 %}
      {% set STEP = 6 %}
      {{ ui.tool_button('nudge__up',              'arrow_up',    x=CX,        y=CY + STEP, size='md', variant='ghost',  halign='center') }}
      {{ ui.tool_button('nudge__left',            'arrow_left',  x=CX - STEP, y=CY,        size='md', variant='ghost',  halign='center') }}
      {{ ui.tool_button('reset__' ~ selected_key, 'undo',        x=CX,        y=CY,        size='md', variant='danger', halign='center', tooltip='Reset position') }}
      {{ ui.tool_button('nudge__right',           'arrow_right', x=CX + STEP, y=CY,        size='md', variant='ghost',  halign='center') }}
      {{ ui.tool_button('nudge__down',            'arrow_down',  x=CX,        y=CY - STEP, size='md', variant='ghost',  halign='center') }}
      {# step selector below d-pad #}
      {% set step_label = (step|int)|string if step == step|int else ('%.1f' | format(step)) %}
      {{ ui.stepper('step', value=step_label, x=4, y=-84, w=30, size='sm') }}
    {% endcall %}

    {# ── numeric entry — current row values ───────────────────────── #}
    {% for row in rows if row.selected %}
      {% set CG_X = 40 %}
      {% set CG_Y = -58 %}
      {% set CG_W = EDIT_W - CG_X %}
      {% set CG_H = 32 %}
      {% set CONTENT_W = 37 %}
      {% set COL1_LBL = CG_X + (CG_W - CONTENT_W) / 2 %}
      {% set COL1_ENT = COL1_LBL + 4 %}
      {% set COL2_LBL = COL1_ENT + 14 + 3 %}
      {% set COL2_ENT = COL2_LBL + 4 %}
      {% set ROW1_Y = CG_Y - 11 %}
      {% set ROW2_Y = CG_Y - 21 %}
      {% call ui.group_box('Coordinates', x=CG_X, y=CG_Y, w=CG_W, h=CG_H, color='aaa') %}
        <label pos="{{ COL1_LBL }} {{ ROW1_Y }}" textsize="0.85" valign="center2" text="$aaaX" />
        <quad  pos="{{ COL1_ENT }} {{ ROW1_Y }}" size="14 4" bgcolor="0008" valign="center2" />
        <entry pos="{{ COL1_ENT }} {{ ROW1_Y }}" size="14 4" name="widget_{{ row.key }}_x"
               default="{{ '%.2f' | format(row.x) }}" textsize="1" valign="center2" />

        <label pos="{{ COL2_LBL }} {{ ROW1_Y }}" textsize="0.85" valign="center2" text="$aaaY" />
        <quad  pos="{{ COL2_ENT }} {{ ROW1_Y }}" size="14 4" bgcolor="0008" valign="center2" />
        <entry pos="{{ COL2_ENT }} {{ ROW1_Y }}" size="14 4" name="widget_{{ row.key }}_y"
               default="{{ '%.2f' | format(row.y) }}" textsize="1" valign="center2" />

        <label pos="{{ COL1_LBL }} {{ ROW2_Y }}" textsize="0.85" valign="center2" text="$aaaW" />
        <quad  pos="{{ COL1_ENT }} {{ ROW2_Y }}" size="14 4" bgcolor="0008" valign="center2" />
        <entry pos="{{ COL1_ENT }} {{ ROW2_Y }}" size="14 4" name="widget_{{ row.key }}_w"
               default="{{ '%.2f' | format(row.w) }}" textsize="1" valign="center2" />

        <label pos="{{ COL2_LBL }} {{ ROW2_Y }}" textsize="0.85" valign="center2" text="$aaaH" />
        <quad  pos="{{ COL2_ENT }} {{ ROW2_Y }}" size="14 4" bgcolor="0008" valign="center2" />
        <entry pos="{{ COL2_ENT }} {{ ROW2_Y }}" size="14 4" name="widget_{{ row.key }}_h"
               default="{{ '%.2f' | format(row.h) }}" textsize="1" valign="center2" />
      {% endcall %}
    {% endfor %}

    {# ── help text ────────────────────────────────────────────────── #}
    <label pos="0 -94" textsize="0.7" sizen="{{ EDIT_W }} 24"
           autonewline="1"
           text="$888The teal overlay marks the selected widget's current position. Nudge with the d-pad (uses the selected step), or type exact values and press Apply. $aaaScope$888 picks where the position is saved: $aaaGlobal$888 writes the default used by every player, while $aaaPersonal$888 stores an override only you see. Slide direction, hide-while-driving, duration and delay are always server-wide." />
  </frame>
  {% else %}
  <frame pos="{{ EDIT_X }} -10" z-index="510">
    <quad pos="0 -2" size="{{ EDIT_W }} {{ WIN_H - 14 }}" bgcolor="0a0a0a55" />
    {{ ui.icon('object-group', x=EDIT_W / 2 - 3, y=-(WIN_H / 2) + 5, color='333', font=8.0) }}
    <label pos="{{ EDIT_W / 2 }} -{{ WIN_H / 2 + 4 }}" halign="center"
           textsize="1.0" text="$888Select a widget on the left." />
  </frame>
  {% endif %}

  {# ── window-level buttons ─────────────────────────────────────────── #}
  {# top-right X is provided by ui.window itself (fires `_close` -> BaseView._on_close) #}
  {# bottom-right cluster: Debug · Dump · Apply (master-only debug/dump in orange) #}
  {% if selected_key %}
    {{ ui.push_button('set__' ~ selected_key, 'Apply', x=WIN_W - 4, y=-(WIN_H - 6),
                      halign='right', size='md', variant='primary', icon='check') }}
  {% endif %}
  {% if is_master %}
    {% if selected_key %}
      {{ ui.push_button('dump__' ~ selected_key, 'Dump',
                        x=WIN_W - 32, y=-(WIN_H - 6), halign='right', size='md',
                        variant='warning', icon='file-code',
                        tooltip='Dump rendered XML of the selected widget to /tmp/tmsm_widget_dump/.') }}
    {% endif %}
    {{ ui.push_button('debug__toggle',
                      ('Debug: ON' if debug else 'Debug'),
                      x=WIN_W - 60, y=-(WIN_H - 6), halign='right', size='md',
                      variant='warning', icon='bug',
                      tooltip='Toggle per-widget debug overlay (master-admin only).') }}
  {% endif %}
</frame>

{# hover animations for every push_button / tool_button in this template #}
{{ ui.hover_script() }}

{# ── visual position indicator for the selected widget only ──────────── #}
<frame pos="0 0" z-index="600">
  {% for row in rows if row.selected %}
    {% set border = '15dfa' %}
    {% set fill   = '15dfa33' %}
    <quad pos="{{ row.x }} {{ row.y }}" size="{{ row.w }} {{ row.h }}"
          halign="left" valign="top" bgcolor="{{ fill }}" />
    <quad pos="{{ row.x }} {{ row.y }}"          size="{{ row.w }} 0.25" halign="left" valign="top" bgcolor="{{ border }}" />
    <quad pos="{{ row.x }} {{ row.y - row.h }}"  size="{{ row.w }} 0.25" halign="left" valign="top" bgcolor="{{ border }}" />
    <quad pos="{{ row.x }} {{ row.y }}"          size="0.25 {{ row.h }}" halign="left" valign="top" bgcolor="{{ border }}" />
    <quad pos="{{ row.x + row.w }} {{ row.y }}"  size="0.25 {{ row.h }}" halign="left" valign="top" bgcolor="{{ border }}" />
  {% endfor %}
</frame>

