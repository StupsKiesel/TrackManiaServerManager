            <label pos="47 -46" textsize="0.75" valign="center2" text="$aaaH" />
            <quad  pos="50 -46" size="7 4" bgcolor="0008" valign="center2" />
            <entry pos="50 -46" size="7 4" name="entry_group_{{ selected_group_key }}_anchor_h"
              default="{{ '%.2f' | format(selected_group_anchor.h) }}" textsize="1" valign="center2" />

            {{ ui.check_box('groupruntime__' ~ selected_group_key ~ '|prev', label='Prev',
                            checked=selected_group_runtime.prev, x=4, y=-53, size='sm') }}
            {{ ui.check_box('groupruntime__' ~ selected_group_key ~ '|next', label='Next',
                            checked=selected_group_runtime.next, x=17, y=-53, size='sm') }}
            {{ ui.check_box('groupruntime__' ~ selected_group_key ~ '|auto', label='Auto',
                            checked=selected_group_runtime.auto, x=30, y=-53, size='sm') }}
            {{ ui.check_box('groupruntime__' ~ selected_group_key ~ '|pin', label='Pin',
                            checked=selected_group_runtime.pin, x=43, y=-53, size='sm') }}
          {% endcall %}

          {# Nudge group box: dpad in center, H+/H- vertical column, W-/W+ horizontal row #}
          {% set NB_X = GS_W + 2 %}
          {% set NB_W = EDIT_W - NB_X %}
          {% set NCX = NB_X + NB_W / 2 %}
          {% call ui.group_box('Nudge', x=NB_X, y=-2, w=NB_W, h=58, color='aaa') %}
            {# vertical sizing column: H+ above the dpad, H- below #}
            {{ ui.tool_button('groupnudge__' ~ selected_group_key ~ '|h_inc', 'plus',
                              x=NCX, y=-10, size='sm', variant='ghost', halign='center', tooltip='Taller') }}
            {# dpad #}
            {{ ui.tool_button('groupnudge__' ~ selected_group_key ~ '|up',    'arrow_up',
                              x=NCX, y=-17, size='sm', variant='ghost', halign='center', tooltip='Move anchor up') }}
            {# horizontal sizing row at the dpad mid-line: W- | left | right | W+ #}
            {{ ui.tool_button('groupnudge__' ~ selected_group_key ~ '|w_dec', 'minus',
                              x=NCX - 9, y=-23, size='sm', variant='ghost', halign='center', tooltip='Narrower') }}
            {{ ui.tool_button('groupnudge__' ~ selected_group_key ~ '|left',  'arrow_left',
                              x=NCX - 3, y=-23, size='sm', variant='ghost', halign='center', tooltip='Move anchor left') }}
            {{ ui.tool_button('groupnudge__' ~ selected_group_key ~ '|right', 'arrow_right',
                              x=NCX + 3, y=-23, size='sm', variant='ghost', halign='center', tooltip='Move anchor right') }}
            {{ ui.tool_button('groupnudge__' ~ selected_group_key ~ '|w_inc', 'plus',
                              x=NCX + 9, y=-23, size='sm', variant='ghost', halign='center', tooltip='Wider') }}
            {{ ui.tool_button('groupnudge__' ~ selected_group_key ~ '|down',  'arrow_down',
                              x=NCX, y=-29, size='sm', variant='ghost', halign='center', tooltip='Move anchor down') }}
            {{ ui.tool_button('groupnudge__' ~ selected_group_key ~ '|h_dec', 'minus',
                              x=NCX, y=-36, size='sm', variant='ghost', halign='center', tooltip='Shorter') }}

            {# stepper at bottom of Nudge box #}
            <label pos="{{ NB_X + 2 }} -45" textsize="0.8" valign="center2" text="$aaaStep" />
            {% set step_label = (step|int)|string if step == step|int else ('%.2f' | format(step)) %}
            {{ ui.stepper('step', value=step_label, x=NB_X + 9, y=-45, w=NB_W - 11, size='sm') }}
          {% endcall %}

          {# Members list — full width, fills remaining space down to action button row #}
          {% set ML_Y = -62 %}
          {% set ML_H = 44 %}
          {% call ui.group_box('Members (' ~ selected_group_member_list|length ~ ')',
                               x=0, y=ML_Y, w=EDIT_W, h=ML_H, color='aaa') %}
            {% if selected_group_member_list %}
              {% for m in selected_group_member_list %}
                {% set my = ML_Y - 8 - (loop.index0 * 5) %}
                <quad pos="2 {{ my }}" size="{{ EDIT_W - 4 }} 4.5"
                      bgcolor="{{ '15dfa22' if m.enabled else '40000033' }}" valign="center2" />
                <label pos="4 {{ my }}" textsize="0.85" valign="center2"
                       text="${{ 'fff' if m.enabled else '888' }}{{ m.name }}" />
                <label pos="4 {{ my - 1.5 }}" textsize="0.6" valign="center2"
                       text="$777{{ m.key }}  $666·  $aaaOrd $fff{{ m.order }}  $666·  $aaaPri $fff{{ m.priority }}" />
                {{ ui.check_box('groupmemberkey__' ~ m.key,
                                label='', checked=m.enabled,
                                x=EDIT_W - 24, y=my, size='sm') }}
                {% if m.can_up %}
                  {{ ui.tool_button('groupmemberorder__' ~ selected_group_key ~ '|' ~ m.key ~ '|up',
                                    'arrow_up', x=EDIT_W - 14, y=my, size='sm', variant='ghost',
                                    halign='center', tooltip='Move up') }}
                {% endif %}
                {% if m.can_down %}
                  {{ ui.tool_button('groupmemberorder__' ~ selected_group_key ~ '|' ~ m.key ~ '|down',
                                    'arrow_down', x=EDIT_W - 8, y=my, size='sm', variant='ghost',
                                    halign='center', tooltip='Move down') }}
                {% endif %}
              {% endfor %}
            {% else %}
              <label pos="{{ EDIT_W / 2 }} {{ ML_Y - 14 }}" halign="center"
                     textsize="0.85" text="$888No widgets assigned. Assign from Widgets tab → Group dropdown." />
            {% endif %}
          {% endcall %}
        {% else %}
          <quad pos="0 -2" size="{{ EDIT_W }} {{ WIN_H - 20 }}" bgcolor="0a0a0a55" />
          {{ ui.icon('object-group', x=EDIT_W / 2 - 3, y=-(WIN_H / 2) + 8, color='333', font=8.0) }}
          <label pos="{{ EDIT_W / 2 }} -{{ WIN_H / 2 + 1 }}" halign="center"
                 textsize="1.0" text="$888No group selected." />
        {% endif %}
      </frame>

      {# Lower window-border action row: Save · Delete · New (right-aligned) #}
      {% if selected_group_key %}
        {{ ui.push_button('savegroup__' ~ selected_group_key, 'Save',
                  x=WIN_W - 4, y=ACTION_ROW_Y, halign='right',
                  size='md', variant='primary') }}
        {{ ui.push_button('delgroup__' ~ selected_group_key,
                ('Delete! Confirm' if selected_group_delete_armed else 'Delete'),
                x=WIN_W - 28, y=ACTION_ROW_Y, halign='right',
                size='md', variant=('warning' if selected_group_delete_armed else 'danger')) }}
      {% endif %}
      {{ ui.push_button('newgroup__create', 'New group',
                x=WIN_W - 54, y=ACTION_ROW_Y, halign='right',
                size='md', variant='success') }}

    {% elif tab_key == 'frame' %}

      {# Master-admin only: global base-frame settings applied to every widget. #}
      <frame pos="2 -16" z-index="510">
        {% call ui.group_box('Global strip', x=0, y=-2, w=WIN_W - 8, h=58, color='aaa') %}

          <label pos="4 -10" textsize="0.9" valign="center2"
                 text="$aaaStrip color override (rgba/rgb hex)" />
          <quad  pos="44 -10" size="24 4" bgcolor="0008" valign="center2" />
          <entry pos="44 -10" size="24 4"
                 name="entry_frame_strip_color_override"
                 default="{{ global_strip_color_override }}"
                 textsize="1" valign="center2" />
          {# Live swatch preview of the override (or 'unset' chip). #}
          {% if global_strip_color_override %}
            <quad pos="70 -10" size="6 4" valign="center2"
                  bgcolor="{{ global_strip_color_override }}" />
          {% else %}
            <quad pos="70 -10" size="6 4" valign="center2" bgcolor="000000aa" />
            <label pos="73 -10" halign="center" valign="center2" textsize="0.7"
                   text="$888unset" />
          {% endif %}
          <label pos="4 -16" textsize="0.7" valign="center2"
                 text="$666Empty = each widget keeps its own WIDGET_STRIP_COLOR." />

          <label pos="4 -26" textsize="0.9" valign="center2"
                 text="$aaaThickness (ML units)" />
          <quad  pos="44 -26" size="10 4" bgcolor="0008" valign="center2" />
          <entry pos="44 -26" size="10 4"
                 name="entry_frame_strip_thickness"
                 default="{{ '%.2f' | format(global_strip_thickness) }}"
                 textsize="1" valign="center2" />
          <label pos="4 -32" textsize="0.7" valign="center2"
                 text="$666Applies to every widget. 0.5-1.2 looks best." />

          <label pos="4 -42" textsize="0.9" valign="center2"
                 text="$aaaBg color override (rgba/rgb hex)" />
          <quad  pos="44 -42" size="24 4" bgcolor="0008" valign="center2" />
          <entry pos="44 -42" size="24 4"
                 name="entry_frame_bg_color_override"
                 default="{{ global_bg_color_override }}"
                 textsize="1" valign="center2" />
          {% if global_bg_color_override %}
            <quad pos="70 -42" size="6 4" valign="center2"
                  bgcolor="{{ global_bg_color_override }}" />
          {% else %}
            <quad pos="70 -42" size="6 4" valign="center2" bgcolor="000000aa" />
            <label pos="73 -42" halign="center" valign="center2" textsize="0.7"
                   text="$888unset" />
          {% endif %}
          <label pos="4 -48" textsize="0.7" valign="center2"
                 text="$666Empty = each widget keeps its own WIDGET_BG_COLOR." />

        {% endcall %}
      </frame>

      {{ ui.push_button('saveframe__set', 'Apply',
                x=WIN_W - 4, y=ACTION_ROW_Y, halign='right',
                size='md', variant='primary', icon='check') }}
      {{ ui.push_button('clearframecolor__x', 'Clear strip',
                x=WIN_W - 32, y=ACTION_ROW_Y, halign='right',
                size='md', variant='danger', icon='times',
                tooltip='Clear the global strip color override.') }}
      {{ ui.push_button('clearframebg__x', 'Clear bg',
                x=WIN_W - 60, y=ACTION_ROW_Y, halign='right',
                size='md', variant='danger', icon='times',
                tooltip='Clear the global bg color override.') }}

    {% elif tab_key == 'presets' %}

      <frame pos="2 -16" z-index="510">
        <quad pos="0 0" size="{{ WIN_W - 4 }} {{ TAB_BODY_H - 2 }}"
              valign="top" bgcolor="0a0a0a55" />

        <label pos="1 -1.2" halign="left" valign="top" textsize="1.1"
               textfont="GameFontBlack"
               text="$fffPresets · global widget config snapshots" />
        <label pos="1 -3.2" halign="left" valign="top" textsize="0.85"
               text="$888Each preset is a full snapshot of WidgetConfigGlobal stored as CSV. Apply globally (persists), apply temporarily (runtime only), or delete." />

        {% set ROW_H = 5 %}
        {% set ROW_Y0 = -6.5 %}
        {% if presets_rows %}
          {% for p in presets_rows %}
            {% set ry = ROW_Y0 - loop.index0 * ROW_H %}
            <quad pos="0.5 {{ ry }}" size="{{ WIN_W - 7 }} {{ ROW_H - 0.5 }}"
                  valign="top" bgcolor="{{ '12121244' if loop.index0 % 2 == 0 else '1a1a1a44' }}" />
            <label pos="1 {{ ry - 0.8 }}" halign="left" valign="top"
                   textsize="1.0" textfont="GameFontBlack"
                   text="$fff{{ p.label }}  $888({{ p.key }})" />
            <label pos="1 {{ ry - 2.5 }}" halign="left" valign="top"
                   textsize="0.8"
                   text="{{ '$f55warnings: ' ~ p.warning_text if not p.ok else '$888' ~ p.count ~ ' widget(s)' }}  $666{{ p.description }}" />

            {% if p.ok %}
              {{ ui.push_button('presetapply__' ~ p.key, 'Apply global',
                        x=WIN_W - 4, y=ry - 0.5, halign='right',
                        size='sm', variant='primary', icon='check',
                        tooltip='Write this preset into WidgetConfigGlobal (persistent).') }}
              {{ ui.push_button('presetapplyrt__' ~ p.key, 'Apply temp',
                        x=WIN_W - 30, y=ry - 0.5, halign='right',
                        size='sm', variant='warning', icon='clock',
                        tooltip='Apply this preset as a runtime override (cleared on restart or by Clear temp).') }}
            {% endif %}
            {{ ui.push_button('presetdel__' ~ p.key, 'Delete',
                      x=WIN_W - 56, y=ry - 0.5, halign='right',
                      size='sm', variant='danger', icon='trash',
                      tooltip='Delete the preset CSV from disk.') }}
          {% endfor %}
        {% else %}
          <label pos="1 -7" halign="left" valign="top" textsize="0.95"
                 text="$888No presets yet — use “Save preset” on the Widgets tab to capture the current config." />
        {% endif %}
      </frame>

      {{ ui.push_button('presetreload__now', 'Reload',
                x=WIN_W - 4, y=ACTION_ROW_Y, halign='right',
                size='md', variant='warning', icon='sync',
                tooltip='Reload preset CSV files from disk.') }}
      {{ ui.push_button('presetclearrt__now', 'Clear temp',
                x=WIN_W - 28, y=ACTION_ROW_Y, halign='right',
                size='md', variant='danger', icon='times',
                tooltip='Clear any preset that was applied temporarily from this editor.') }}

    {% endif %}

  {% endcall %}

</frame>

{{ ui.hover_script() }}

{% if editor_tab == 'widgets' %}
<frame pos="0 0" z-index="600">
  {% for row in rows if row.selected %}
    {% set border = '15dfa' %}
    {% set fill   = '15dfa33' %}
    <quad pos="{{ row.x }} {{ row.y }}" size="{{ row.w }} {{ row.h }}"
          halign="left" valign="top" bgcolor="{{ fill }}" />
    <quad pos="{{ row.x }} {{ row.y }}"          size="{{ row.w }} 0.25" halign="left" valign="top" bgcolor="{{ border }}" />
    <quad pos="{{ row.x }} {{ row.y - row.h }}"  size="{{ row.w }} 0.25" halign="left" valign="top" bgcolor="{{ border }}" />
    <quad pos="{{ row.x }} {{ row.y }}"          size="0.25 {{ row.h }}" halign="left" valign="top" bgcolor="{{ border }}" />
    <quad pos="{{ row.x + row.w }} {{ row.y }}"  size="0.25 {{ row.h }}" halign="left" valign="top" bgcolor="{{ border }}" />
  {% endfor %}
</frame>
{% elif editor_tab == 'groups' and selected_group_key %}
<frame pos="0 0" z-index="600">
  {% set gx = selected_group_anchor.x %}
  {% set gy = selected_group_anchor.y %}
  {% set gw = selected_group_anchor.w %}
  {% set gh = selected_group_anchor.h %}
  {% set border = 'f0fa' %}
  {% set fill   = 'f0f22' %}
  <quad pos="{{ gx }} {{ gy }}" size="{{ gw }} {{ gh }}"
        halign="left" valign="top" bgcolor="{{ fill }}" />
  <quad pos="{{ gx }} {{ gy }}"           size="{{ gw }} 0.25" halign="left" valign="top" bgcolor="{{ border }}" />
  <quad pos="{{ gx }} {{ gy - gh }}"      size="{{ gw }} 0.25" halign="left" valign="top" bgcolor="{{ border }}" />
  <quad pos="{{ gx }} {{ gy }}"           size="0.25 {{ gh }}" halign="left" valign="top" bgcolor="{{ border }}" />
  <quad pos="{{ gx + gw }} {{ gy }}"      size="0.25 {{ gh }}" halign="left" valign="top" bgcolor="{{ border }}" />
  <label pos="{{ gx + 0.5 }} {{ gy - 0.4 }}" halign="left" valign="top"
         textsize="0.85" textfont="GameFontBlack"
         text="$f0f{{ selected_group_key }}" />
</frame>
{% endif %}
