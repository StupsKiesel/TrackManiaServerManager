{% import 'tmsm_ui/widgets.xml' as ui with context %}
{% import 'tmsm_widgets/frame.xml' as widgets with context %}

{# Hub launcher rendered as a movable widget. Position (per-player and
   global override) is resolved by the tmsm_widgets app and injected by
   widgets.frame(). The widget's bounding box is widget_w x widget_h; we
   fill it with the launcher button. #}
{% call widgets.frame() %}
  <quad pos="0 0" z-index="2" size="{{ widget_w }} {{ widget_h }}"
        bgcolor="0000" halign="left" valign="top"
        id="uibtn_ghost_{{ id }}__toggle"
        action="{{ id }}__toggle" scriptevents="1"
        class="ui-btn ui-btn-ghost" />
  <label pos="{{ widget_w / 2 }} {{ -widget_h / 2 }}" z-index="3"
         halign="center" valign="center2"
         text="$fff{{ '&#xf0c9;'|safe }}" textsize="2.4" textfont="GameFont" />
{% endcall %}

{{ ui.hover_script() }}
