{% import 'tmsm_widgets/frame.xml' as widgets with context %}

{% set clock_init %}
  declare CMlLabel ClockLabel <=> (Page.GetFirstChild("clock_label") as CMlLabel);
{% endset %}

{% set clock_tick %}
  if (ClockLabel != Null) {
    ClockLabel.SetText("$fff" ^ TL::SubString(CurrentLocalDateText, 11, 8));
  }
{% endset %}

{% call widgets.frame(extra_init=clock_init, extra_tick=clock_tick) %}
  <quad pos="0 0" z-index="40" size="{{ widget_w }} {{ widget_h }}"
        bgcolor="111c" halign="left" valign="top" />
  <quad pos="0 0" z-index="41" size="{{ widget_w }} 1.2"
        bgcolor="15ff" halign="left" valign="top" />
  <label pos="{{ widget_w / 2 }} {{ -widget_h / 2 }}" z-index="42"
         id="clock_label"
         halign="center" valign="center2"
         text="$fff--:--:--"
         textsize="1.8" textfont="GameFontBlack" />
{% endcall %}
