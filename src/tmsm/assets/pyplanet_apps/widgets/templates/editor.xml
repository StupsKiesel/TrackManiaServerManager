                 text="$777{{ row.key }}" />
          <label pos="11 {{ y - 7.6 }}" textsize="0.7" valign="top"
               text="$aaaOrder $fff{{ row.order }}  $666·  $aaaWidgets $fff{{ row.usage_count|default(0) }}" />
