<frame pos="{{ widget_x }} {{ widget_y }}" z-index="100">
  <!-- AUTO checkbox row, sits above the button -->
  <quad pos="0 8" z-index="0" size="22 6" bgcolor="0006" halign="right" valign="center"
        action="{{ id }}__toggle_watch" scriptevents="1" />
  <quad pos="-19 8" z-index="1" size="3.5 3.5" halign="center" valign="center"
        bgcolor="{% if watch_active %}0d48{% else %}4448{% endif %}"
        action="{{ id }}__toggle_watch" scriptevents="1" />
  {% if watch_active %}
  <label pos="-19 8" z-index="2" halign="center" valign="center2"
         text="$000$o&#xf00c;" textsize="0.9" textfont="GameFontBlack" />
  {% endif %}
  <label pos="-15 8" z-index="2" halign="left" valign="center2"
         text="$fff$oAUTO" textsize="0.9" textfont="GameFontBlack"
         action="{{ id }}__toggle_watch" scriptevents="1" />

  <!-- Manual RELOAD button -->
  <quad pos="0 0" z-index="0" size="22 7" bgcolor="8006" halign="right" valign="center"
        action="{{ id }}__reload" scriptevents="1" />
  <label pos="-11 0" z-index="1" size="20 7" halign="center" valign="center2"
         text="$fff$o&#xf021; RELOAD" textsize="1.1" textfont="GameFontBlack"
         action="{{ id }}__reload" scriptevents="1" />
</frame>
