            {% set _dh = 3.6 %}
            {% set _dx = LIST_W - 1.2 %}
            {% set _dy = y - ROW_H + 4.0 %}
            <quad pos="{{ _dx }} {{ _dy }}" size="{{ _dw }} {{ _dh }}"
                  halign="right" valign="top" z-index="2"
                  bgcolor="{{ 'f55a' if row.disabled else 'ffffff18' }}" />
            {{ ui.icon('power-off',
                       x=_dx - _dw/2, y=_dy - _dh/2 + 0.1,
                       color='fff' if row.disabled else '888',
                       font=1.6, z=3) }}
