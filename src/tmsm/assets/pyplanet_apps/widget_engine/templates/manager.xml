          {% set rp_visible = rp_end - rp_start + 1 %}
          {% set rp_cells = 4 + rp_visible %}
          {% if rp_start > 1 %}{% set rp_cells = rp_cells + 1 %}{% if rp_start > 2 %}{% set rp_cells = rp_cells + 1 %}{% endif %}{% endif %}
          {% if rp_end < replacements_total_pages %}{% set rp_cells = rp_cells + 1 %}{% if rp_end < replacements_total_pages - 1 %}{% set rp_cells = rp_cells + 1 %}{% endif %}{% endif %}
          {% set rp_total_w = rp_cells * (rp_btn_w + rp_gap) - rp_gap %}
          {% set rp_pag_x = (RP_W - rp_total_w) / 2 %}
          {% set rp_pag_y = RP_BODY_TOP - 1 - (4 * (CARD_H + CARD_GAP)) - 1 %}
          {{ ui.pagination('replacements__pag',
