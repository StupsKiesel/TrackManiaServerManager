                          'REMOVE', icon='times',
                          x=UM_RW - 4, y=cy - 2.2,
                          width=14, halign='right',
                          variant='ghost', size='sm', z=137) }}
      {% endfor %}
    </frame>
    {% set custom_y_end = UM_BODY_TOP - 11 - (ui_modules_editor.custom_ids|length * 5) - 2 %}
  {% endif %}

  {# Add-custom input + button #}
  <label pos="{{ UM_RX + 1.5 }} {{ custom_y_end - 4 }}" z-index="135"
         halign="left" valign="center2"
         text="$888Add UI module id"
         textsize="0.85" textfont="GameFont" />
  {{ ui.line_edit('ui_modules_editor__input',
                  value=ui_modules_editor.input,
                  x=UM_RX + 1.5, y=custom_y_end - 8.5,
                  width=UM_RW - 19, size='sm', z=136) }}
  {{ ui.push_button('ui_modules_editor__add', 'ADD', icon='plus',
                    x=UM_RX + UM_RW - 2, y=custom_y_end - 8.5,
                    width=16, halign='right',
                    variant='primary', size='sm', z=137) }}

  {# ──── footer: action buttons ──────────────────────────────── #}
  <quad pos="{{ UM_LX }} {{ UM_FOOTER_Y + 4 }}" z-index="134"
        size="{{ UM_W - 4 }} 0.2"
        bgcolor="ffffff22" halign="left" valign="top" />
  {{ ui.push_button('ui_modules_editor__cancel', 'Cancel', icon='times',
                    x=UM_LX, y=UM_FOOTER_Y,
                    halign='left', size='md', variant='ghost', z=140) }}
  {% if ui_modules_editor.overridden %}
    {{ ui.push_button('ui_modules_editor__reset',
                      'Reset to default', icon='undo',
                      x=UM_W - 38, y=UM_FOOTER_Y,
                      halign='right', size='md', variant='warning', z=140) }}
  {% endif %}
  {{ ui.push_button('ui_modules_editor__save', 'Save', icon='check',
                    x=UM_W - 2, y=UM_FOOTER_Y,
                    halign='right', size='md', variant='primary', z=140) }}
{% endif %}

</frame>

{# ── confirm-remove dialog (overlay) ───────────────────────────────── #}
{% if confirm_remove_key %}
  {{ ui.confirm_dialog('confirm_remove',
                       title='Remove widget',
           message='Remove "' ~ confirm_remove_name ~
             '" from this phase only? ' ~
             'The widget stays installed for other phases.',
                       open=True, danger=True,
                       ok_label='Remove', ok_icon='trash',
                       cancel_label='Cancel') }}
{% endif %}

{{ ui.hover_script() }}
