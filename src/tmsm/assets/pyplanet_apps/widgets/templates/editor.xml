{% import 'tmsm_ui/widgets.xml' as ui with context %}

{# Mirror of ui.pagination cell-count logic so we can center the strip
   horizontally within an arbitrary list width. #}
{% macro centered_pagination(name, page, total_pages, list_x, list_w, y,
                              max_visible=5, btn_w=5, btn_h=5, gap=0.5) %}
  {% if total_pages < 1 %}{% set total_pages = 1 %}{% endif %}
  {% if page < 1 %}{% set page = 1 %}{% endif %}
  {% if page > total_pages %}{% set page = total_pages %}{% endif %}
  {% set half = (max_visible // 2) %}
  {% set start = page - half %}
  {% set end = page + half %}
  {% if start < 1 %}{% set end = end + (1 - start) %}{% set start = 1 %}{% endif %}
  {% if end > total_pages %}{% set start = start - (end - total_pages) %}{% set end = total_pages %}{% endif %}
  {% if start < 1 %}{% set start = 1 %}{% endif %}
  {% set visible = end - start + 1 %}
  {% set cells = 4 + visible %}
  {% if start > 1 %}{% set cells = cells + 1 %}{% if start > 2 %}{% set cells = cells + 1 %}{% endif %}{% endif %}
  {% if end < total_pages %}{% set cells = cells + 1 %}{% if end < total_pages - 1 %}{% set cells = cells + 1 %}{% endif %}{% endif %}
  {% set total_w = cells * (btn_w + gap) - gap %}
  {% set cx = list_x + (list_w - total_w) / 2 %}
  {{ ui.pagination(name, page=page, total_pages=total_pages,
                   x=cx, y=y, max_visible=max_visible,
                   btn_w=btn_w, btn_h=btn_h, gap=gap) }}
{% endmacro %}

{% set WIN_W = 170 %}
{% set WIN_H = 136 %}
{% set ROW_H = 11 %}
{% set LIST_W = 70 %}
{% set EDIT_X = LIST_W + 4 %}
{% set EDIT_W = WIN_W - EDIT_X - 4 %}
{% set ACTION_ROW_Y = -(WIN_H - 7) %}
{% set TAB_BODY_H = WIN_H - 25 %}
{% set LIST_H = TAB_BODY_H - 8 %}

<frame pos="-85 55" z-index="500">

  {{ ui.window('Widgets · editor', icon='object-group', x=0, y=0, w=WIN_W, h=WIN_H) }}

  {% call(tab_key, t) ui.tabs('mode', editor_tabs, active=editor_tab,
                              x=2, y=-10, w=WIN_W - 4, tab_h=5, body_h=TAB_BODY_H, z=300) %}

    {% if tab_key == 'widgets' %}

      <quad pos="{{ LIST_W + 2 }} -16" size="0.2 {{ TAB_BODY_H - 2 }}"
            valign="top" bgcolor="ffffff22" z-index="509" />

      <frame pos="2 -16" z-index="510">
        {% for row in rows %}
          {% set y = -(loop.index0 * (ROW_H + 1)) %}
          <quad pos="0 {{ y }}" size="{{ LIST_W }} {{ ROW_H }}" valign="top"
                bgcolor="{{ '1a4fa6cc' if row.selected else '0a0a0a88' }}" />
          {% if row.selected %}
            <quad pos="0 {{ y }}" size="0.8 {{ ROW_H }}" valign="top" bgcolor="15dfa" />
          {% endif %}
          <quad pos="1.5 {{ y - 1.5 }}" size="8 8" valign="top"
                bgcolor="{{ '15dfa44' if row.selected else 'ffffff10' }}" />
          {{ ui.icon(row.icon, x=5.5, y=y - 5.5, color='15f' if row.selected else 'ccc',
                     font=3.4, z=512) }}
          <label pos="11 {{ y - 1.2 }}" textsize="1.0" textfont="GameFontBlack" valign="top"
                 text="{{ '$888' if row.disabled else '$fff' }}{{ row.name }}{{ '  $f55[DISABLED]' if row.disabled else '' }}" />
          <label pos="11 {{ y - 4.1 }}" textsize="0.7" valign="top"
                 text="$777{{ row.key }}" />
          <label pos="11 {{ y - 7.6 }}" textsize="0.7" valign="top"
                 text="$aaaSize $fff{{ '%.0f' | format(row.w) }}×{{ '%.0f' | format(row.h) }}  $666·  $aaaPos $fff{{ '%.1f' | format(row.x) }} , {{ '%.1f' | format(row.y) }}" />
