{% import 'tmsm_ui/widgets.xml' as ui with context %}

{# Per-player ctx provides: active_kind, tabs, prompt, hint, lines, input_value,
   last_status, last_status_color, log_path #}

{% set W = 220 %}
{% set H = 145 %}

<frame pos="-110 72" z-index="200">

  {{ ui.window('Console', icon='terminal', x=0, y=0, w=W, h=H) }}

  {% call(tab_key, t) ui.tabs('kind', tabs, active=active_kind,
                               x=2, y=-10, w=W - 4, tab_h=5, body_h=H - 18) %}

    {# log area #}
    <quad pos="4 -18" z-index="201" size="{{ W - 8 }} 100" bgcolor="0006"
          halign="left" valign="top" />
    {% set max_lines = 30 %}
    {% set ln = lines[-max_lines:] %}
    {% for line in ln|reverse %}
      {% set y = -20 - loop.index0 * 3.2 %}
      {% set color = 'f88' if '[err]' in line or 'ERROR' in line or 'Traceback' in line
                     else ('ff8' if 'WARNING' in line or '[warn]' in line
                     else ('8f8' if line.startswith('$') or line.startswith('>') else 'ddd')) %}
      <label pos="6 {{ y }}" z-index="202" halign="left" valign="center2"
             text="${{ color }}{{ line }}" textsize="0.85" textfont="GameFont" />
    {% endfor %}

    {# input row #}
    {{ ui.label(prompt, x=4, y=-122, color='15f', bold=True) }}
    {{ ui.line_edit('cmd', value=input_value, x=10, y=-122, width=160, size='md') }}
    {{ ui.push_button('send', 'Send', icon='check',
                      x=172, y=-122, variant='success', halign='left', size='md') }}
    {{ ui.push_button('clear', 'Clear', icon='trash',
                      x=192, y=-122, variant='danger', halign='left', size='md') }}

    {# hint + status #}
    {{ ui.label(hint, x=4, y=-130, color='888', size='sm') }}
    {{ ui.label(last_status, x=W - 4, y=-130, color=last_status_color,
                halign='right', size='sm') }}

    {# log path foot label #}
    {{ ui.label(log_path or '(no log file)', x=4, y=-138, color='666', size='sm') }}

  {% endcall %}

  {{ ui.hover_script() }}
</frame>
