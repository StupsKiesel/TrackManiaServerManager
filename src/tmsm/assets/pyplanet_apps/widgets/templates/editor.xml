          {% set CG_Y = -68 %}
          {% set CG_W = EDIT_W %}
          {% set CG_H = 12 %}
          {% set ROW_Y = CG_Y - 7 %}
          {% call ui.group_box('Coordinates', x=CG_X, y=CG_Y, w=CG_W, h=CG_H, color='aaa') %}
