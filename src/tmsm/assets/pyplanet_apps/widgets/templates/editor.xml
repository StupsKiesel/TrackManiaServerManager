      </frame>

      {{ centered_pagination('groupspage', groups_page + 1, groups_total_pages,
                              list_x=0, list_w=LIST_W, y=ACTION_ROW_Y - 2,
                              max_visible=5, btn_w=5, btn_h=5) }}

