                   default="{{ '%.2f' | format(row.x) }}" textsize="1" valign="center2" />

           <label pos="26 {{ ROW_Y }}" textsize="0.85" valign="center2" text="$aaaY" />
           <quad  pos="30 {{ ROW_Y }}" size="12 4" bgcolor="0008" valign="center2" />
           <entry pos="30 {{ ROW_Y }}" size="12 4" name="widget_{{ row.key }}_y"
                   default="{{ '%.2f' | format(row.y) }}" textsize="1" valign="center2" />

           <label pos="48 {{ ROW_Y }}" textsize="0.85" valign="center2" text="$aaaW" />
           <quad  pos="52 {{ ROW_Y }}" size="12 4" bgcolor="0008" valign="center2" />
           <entry pos="52 {{ ROW_Y }}" size="12 4" name="widget_{{ row.key }}_w"
                   default="{{ '%.2f' | format(row.w) }}" textsize="1" valign="center2" />

           <label pos="70 {{ ROW_Y }}" textsize="0.85" valign="center2" text="$aaaH" />
           <quad  pos="74 {{ ROW_Y }}" size="12 4" bgcolor="0008" valign="center2" />
           <entry pos="74 {{ ROW_Y }}" size="12 4" name="widget_{{ row.key }}_h"
                   default="{{ '%.2f' | format(row.h) }}" textsize="1" valign="center2" />
          {% endcall %}
        {% endfor %}

        {% if is_master %}
        {% call ui.group_box('Group config', x=0, y=-82, w=EDIT_W, h=22, color='aaa') %}
          <label pos="4 -90" textsize="0.85" valign="center2" text="$aaaGroup" />
          {{ ui.combo_box('groupkey__' ~ selected_key,
                          group_options,
                          selected=behavior.get('group_key', '__none__') or '__none__',
                          open=group_combo_open,
                          x=14, y=-90, w=42, size='sm', z=320) }}
          <label pos="58 -90" textsize="0.85" valign="center2" text="$aaaPri" />
          <quad  pos="63 -90" size="8 4" bgcolor="0008" valign="center2" />
          <entry pos="63 -90" size="8 4"
                 name="entry_widget_{{ selected_key }}_group_priority"
                 default="{{ behavior.get('group_priority', 0) }}"
                 textsize="1" valign="center2" />
          <label pos="73 -90" textsize="0.85" valign="center2" text="$aaaOrd" />
          <quad  pos="78 -90" size="8 4" bgcolor="0008" valign="center2" />
          <entry pos="78 -90" size="8 4"
                 name="entry_widget_{{ selected_key }}_group_order"
                 default="{{ behavior.get('group_order', 0) }}"
                 textsize="1" valign="center2" />
          {{ ui.check_box('groupmember__' ~ selected_key,
                          label='Member enabled',
                          checked=behavior.get('group_member_enabled', True),
                          x=4, y=-97, size='sm') }}
        {% endcall %}
        {% endif %}
      </frame>
      {% else %}
      <frame pos="{{ EDIT_X }} -16" z-index="510">
        <quad pos="0 -2" size="{{ EDIT_W }} {{ WIN_H - 20 }}" bgcolor="0a0a0a55" />
        {{ ui.icon('object-group', x=EDIT_W / 2 - 3, y=-(WIN_H / 2) + 8, color='333', font=8.0) }}
        <label pos="{{ EDIT_W / 2 }} -{{ WIN_H / 2 + 1 }}" halign="center"
               textsize="1.0" text="$888Select a widget on the left." />
      </frame>
      {% endif %}

      {% set ACT_BTN_STEP = 18 %}
      {% set ACT_BTN_RIGHT = WIN_W - 4 %}
      {% set ACT_BTN_Y = ACTION_ROW_Y - 2 %}
      {% if selected_key %}
        {{ ui.push_button('set__' ~ selected_key, 'Apply',
                          x=ACT_BTN_RIGHT, y=ACT_BTN_Y,
                          halign='right', size='sm', variant='primary', icon='check') }}
      {% endif %}
      {% if is_master %}
        {% if selected_key %}
          {{ ui.push_button('dump__' ~ selected_key, 'Dump',
                            x=ACT_BTN_RIGHT - ACT_BTN_STEP, y=ACT_BTN_Y,
                            halign='right', size='sm',
                            variant='warning', icon='file-code',
                            tooltip='Dump rendered XML of the selected widget to /tmp/tmsm_widget_dump/.') }}
        {% endif %}
        {{ ui.push_button('debug__toggle',
                          ('Debug: ON' if debug else 'Debug'),
                          x=ACT_BTN_RIGHT - (2 * ACT_BTN_STEP), y=ACT_BTN_Y,
                          halign='right', size='sm',
                          variant='warning', icon='bug',
                          tooltip='Toggle per-widget debug overlay (master-admin only).') }}
        {{ ui.push_button('writedefaults__now', 'Defaults',
                          x=ACT_BTN_RIGHT - (3 * ACT_BTN_STEP), y=ACT_BTN_Y,
                          halign='right', size='sm',
                          variant='warning', icon='save',
                          tooltip='Write current widget DB config snapshot to defaults.json.') }}
        {{ ui.push_button('presetsnap__now', 'Save preset',
                          x=ACT_BTN_RIGHT - (4 * ACT_BTN_STEP), y=ACT_BTN_Y,
                          halign='right', size='sm',
                          variant='success', icon='camera',
                          tooltip='Snapshot the current global widget config as a new preset CSV.') }}
      {% endif %}

    {% elif tab_key == 'groups' %}

      <quad pos="{{ LIST_W + 2 }} -16" size="0.2 {{ TAB_BODY_H - 2 }}"
            valign="top" bgcolor="ffffff22" z-index="509" />

      <frame pos="2 -16" z-index="510">
        {% for row in groups_rows %}
          {% set y = -(loop.index0 * (ROW_H + 1)) %}
          <quad pos="0 {{ y }}" size="{{ LIST_W }} {{ ROW_H }}" valign="top"
                bgcolor="{{ '1a4fa6cc' if row.selected else '0a0a0a88' }}" />
          {% if row.selected %}
            <quad pos="0 {{ y }}" size="0.8 {{ ROW_H }}" valign="top" bgcolor="15dfa" />
          {% endif %}
          <quad pos="1.5 {{ y - 1.5 }}" size="8 8" valign="top"
                bgcolor="{{ '15dfa44' if row.selected else 'ffffff10' }}" />
