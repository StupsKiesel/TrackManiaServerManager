                 halign="left" valign="center2"
                 text="$fff{{ grp.group }}"
                 textsize="1.0" textfont="GameFontBlack" />
          {# items #}
          {% for it in grp.entries %}
            {% set iy = gy - 4 - loop.index0 * 5 %}
            <quad pos="{{ gx }} {{ iy }}" size="{{ GROUP_W }} 4.6"
                  valign="top" halign="left"
                  bgcolor="{{ '15151588' if loop.index0 % 2 == 0 else '0a0a0a88' }}" />
            <label pos="{{ gx + 1.5 }} {{ iy - 1.4 }}" z-index="136"
                   halign="left" valign="center2"
                   text="${{ '8fc' if it.in_use else 'ccc' }}{{ it.id }}"
