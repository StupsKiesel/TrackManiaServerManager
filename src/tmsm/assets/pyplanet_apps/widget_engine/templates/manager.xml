    {# ===== Catalog tab ============================================= #}
    {% elif tab_key == 'catalog' %}
      <label pos="3 {{ RP_BODY_TOP - 1 }}" z-index="135"
             halign="left" valign="center2"
             text="$888Curated reference of replaceable HUD targets. Items marked $0d8fIN USE$888 are hooked by an installed widget."
             textsize="0.9" textfont="GameFont" />
