        {% else %}
          <quad pos="0 -10" size="{{ LIST_W }} 12" valign="top" bgcolor="0a0a0a88" />
          <label pos="{{ LIST_W / 2 }} -16" halign="center" textsize="0.9"
                 text="$aaaNo groups registered." />
